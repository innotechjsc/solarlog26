# Server Configuration
PORT=5023
NODE_ENV=development

# Swagger UI: nếu để trống, Try it out dùng URL tương đối `/` (đúng domain đang mở). Chỉ set khi cần ép base URL.
# Viết sát dấu = (không có khoảng trắng): SWAGGER_SERVER_URL=https://sol.adtrade.site
# SWAGGER_SERVER_URL=https://sol.adtrade.site

# MongoDB Configuration
MONGODB_URI=mongodb://admin:solarlogger123@localhost:27019/solarlogger?authSource=admin

# API Security
API_KEY_HEADER=X-API-Key
ALLOWED_API_KEYS=your-api-key-here,another-api-key

# HTTP D2C (fallback khi không MQTT): POST /api/v1/d2c/... — Authorization Bearer {device_token}
# Nếu để trống: dùng chung ALLOWED_API_KEYS. Phải cấu hình ít nhất một token thì D2C mới nhận.
# D2C_BEARER_TOKENS=device-token-1,device-token-2
# D2C_RATE_LIMIT_MAX=2000

# TLS trực tiếp trong Node (tùy chọn; production thường TLS ở IIS/Nginx reverse proxy)
# Cloudflare SSL Flexible: client vẫn dùng https://domain/...; origin có thể chỉ HTTP — không cần SSL_* ở Node.
# SSL_KEY_FILE=/path/to/privkey.pem
# SSL_CERT_FILE=/path/to/fullchain.pem

# JWT Authentication (for CMS)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS (nhiều origin cách nhau bằng dấu phẩy; cần cho admin tại sol.adtrade.site gọi upload.adtrade.site)
# CORS_ORIGIN=http://localhost:3001
# CORS_ORIGIN=https://sol.adtrade.site,https://upload.adtrade.site,http://localhost:3001

# Timezone
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# Envelope §1 — bắt buộc site_id, schema_version, payload_type (trừ legacy data.system)
# IOT_ENVELOPE_STRICT=true

# OTA / Release server (firmware updates via MQTT)
# Broker: có thể dùng Aedes (node scripts/mqtt-broker-local.js) hoặc Mosquitto/EMQX bên ngoài.
# Khi dùng Mosquitto thì không lấy được danh sách device đang sub → trong admin chọn thiết bị từ danh sách CMS.
# Spec: payload/mqtt_topics.pdf - topic ota/cm4/<device_id>/command, payload {"action":"update", "url", "version", "checksum"}
MQTT_BROKER_URL=mqtt://localhost:1883
# TLS chuẩn mới (server-auth): dùng mqtts://host:8883 và cert server hợp lệ
# MQTT_BROKER_URL=mqtts://mqtt.your-domain.com:8883
# Legacy broadcast topic (khi publish không truyền device_ids)
MQTT_OTA_TOPIC=ota/release
# Prefix topic command theo spec: ota/cm4/<device_id>/command
MQTT_OTA_TOPIC_PREFIX=ota/cm4
# Broker auth (Aedes hoặc Mosquitto): nếu broker yêu cầu auth thì đặt cả hai
MQTT_USERNAME=
MQTT_PASSWORD=
# TLS cho MQTT client (backend → broker)
# MQTT_TLS_ENABLED=true
# MQTT_TLS_REJECT_UNAUTHORIZED=true
# MQTT_TLS_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# MQTT_TLS_SERVERNAME=mqtt.your-domain.com
MQTT_STATS_URL=http://localhost:1884
# MQTT_STATS_URL chỉ dùng khi broker là Aedes (mqtt-broker-local.js): số sub + GET /subscribed-devices
RELEASES_DIR=
OTA_BASE_URL=
# OTA_BASE_URL=https://your-domain.com  (for device download URL in MQTT message)

# --- MQTT telemetry ingest (api/solar_logger_payload_desc.md G1 — telemetry qua broker) ---
# Topic mặc định (khi KHÔNG set MQTT_TELEMETRY_SUBSCRIBE_TOPICS):
# - Legacy: <MQTT_TELEMETRY_ROOT>/<site_id>/<device_id>/telemetry/<kind>
# - Spec G1: vpp/<site_id>/telemetry/<slice> và vpp/<site_id>/telemetry/inverter/<inv_id>
# Ví dụ: solar/site-hcm-001/solar-logger-test/telemetry/inverter
MQTT_TELEMETRY_INGEST_ENABLED=false
MQTT_TELEMETRY_ROOT=solar
# Nhiều pattern, phân tách bằng dấu phẩy (tùy broker):
# MQTT_TELEMETRY_SUBSCRIBE_TOPICS — tùy chọn, phân tách bằng dấu phẩy. Mặc định gồm:
# solar/+/+/telemetry/+, vpp/+/telemetry/+, vpp/+/telemetry/inverter/+,
# vpp/+/report, vpp/+/status, vpp/+/alarm, vpp/+/metering,
# vpp/+/dispatch/response, vpp/+/config/ack, vpp/+/ota/progress, vpp/+/ota/result, vpp/+/sync/data
# MQTT_TELEMETRY_SUBSCRIBE_TOPICS=solar/+/+/telemetry/+

# Subdomain riêng cho upload firmware (bypass Cloudflare khi file >100MB)
# OTA_UPLOAD_BASE_URL=https://upload.adtrade.site
# Lưu ý: host upload (IIS) cần CORS_ORIGIN có https://sol.adtrade.site và web.config: maxAllowedContentLength="209715200" (200 MB) - xem FIX-413-UPLOAD-LIMIT.md

