{
  "name": "solarlogger-backend",
  "version": "1.0.0",
  "description": "Backend API for SolarLogger monitoring system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "seed": "node scripts/seed-sample-data.js",
    "mqtt-broker": "node scripts/mqtt-broker-local.js",
    "start:ota-local": "concurrently -n mqtt,api \"npm run mqtt-broker\" \"npm start\""
  },
  "keywords": [
    "solarlogger",
    "solar",
    "monitoring",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mqtt": "^5.10.0",
    "multer": "^1.4.5-lts.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "moment-timezone": "^0.5.43",
    "mongoose": "^8.0.3",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "aedes": "^0.50.0",
    "concurrently": "^9.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/iis-deploy/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/iis-deploy/"
    ]
  }
}
